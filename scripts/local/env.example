# Local run variables (names + harmless local values only). Do NOT put real secrets here.
# Usage:  set -a; source scripts/local/env.example; set +a
# Real AWS credentials (needed by Bedrock) stay as they are; moto ignores them.
# Do not export AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY here.
AWS_ENDPOINT_URL_DYNAMODB=http://127.0.0.1:5001
AWS_DEFAULT_REGION=us-east-1
LOGISTIC_AI_AWS_REGION=us-east-1
LOGISTIC_AI_KB_TABLE=logistic-ai-kb
LOGISTIC_AI_USERS_TABLE=logistic-ai-users
LOGISTIC_AI_PERMISSIONS_TABLE=logistic-ai-permissions
# Same value in BOTH processes (agentcore dev and streamlit); at least 16 characters.
LOGISTIC_AI_SESSION_SECRET=local-dev-only-session-secret
# Streamlit local transport (loopback only)
LOGISTIC_AI_LOCAL_AGENT_URL=http://127.0.0.1:8081/invocations
# Required by the agent; set to a discovered 'global.' inference profile (see README), e.g.:
# LOGISTIC_AI_MODEL_ID=global.anthropic.claude-haiku-4-5-...
