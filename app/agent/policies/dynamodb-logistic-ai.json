{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "KbRead",
      "Effect": "Allow",
      "Action": ["dynamodb:Query"],
      "Resource": ["arn:aws:dynamodb:REGION:ACCOUNT_ID:table/logistic-ai-kb"]
    },
    {
      "Sid": "UsersByUserIdIndexRead",
      "Effect": "Allow",
      "Action": ["dynamodb:Query"],
      "Resource": ["arn:aws:dynamodb:REGION:ACCOUNT_ID:table/logistic-ai-users/index/userid-index"]
    },
    {
      "Sid": "PermissionsRead",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem"],
      "Resource": ["arn:aws:dynamodb:REGION:ACCOUNT_ID:table/logistic-ai-permissions"]
    }
  ]
}
